<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="center" spacing="10" style="-fx-padding: 20; -fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.BookDetailsController">

    <!-- Titel -->
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Buchdetails" />

    <!-- Container für dynamischen Inhalt -->
    <StackPane fx:id="contentPane" alignment="center" prefHeight="400" prefWidth="600" style="-fx-padding: 10;">
        <!-- Standardinhalt (Buchdetails) -->
        <VBox fx:id="bookDetailsView" alignment="center" spacing="10">
            <HBox alignment="center" spacing="10">
                <Label text="Buch ID:" />
                <Label fx:id="bookIdLabel" />
            </HBox>

            <HBox alignment="center" spacing="10">
                <Label text="Titel:" />
                <Label fx:id="titleLabel" />
            </HBox>

            <HBox alignment="center" spacing="10">
                <Label text="Autor:" />
                <Label fx:id="authorLabel" />
            </HBox>

            <HBox alignment="center" spacing="10">
                <Label text="ISBN Lang:" />
                <Label fx:id="isbnLongLabel" />
            </HBox>

            <HBox alignment="center" spacing="10">
                <Label text="ISBN Kurz:" />
                <Label fx:id="isbnShortLabel" />
            </HBox>

            <HBox alignment="center" spacing="10">
                <Label text="Verlag:" />
                <Label fx:id="publisherLabel" />
            </HBox>

            <HBox alignment="center" spacing="10">
                <Label text="Erscheinungsjahr:" />
                <Label fx:id="yearPublishedLabel" />
            </HBox>

            <HBox alignment="center" spacing="10">
                <Label text="Beschreibung:" />
            </HBox>
            <TextArea fx:id="descriptionArea" editable="false" prefHeight="100" prefWidth="400" wrapText="true" />

            <HBox alignment="center" spacing="10">
                <Label text="Status:" />
                <Label fx:id="statusLabel" />
            </HBox>

            <HBox alignment="center" spacing="10">
                <Label text="Kopien:" />
                <Label fx:id="copiesLabel" />
            </HBox>

            <HBox alignment="center" spacing="10">
                <Label text="Keyword ID:" />
                <Label fx:id="keywordIdLabel" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- Buttons -->
    <HBox alignment="center" spacing="10">
        <Button onAction="#showReviews" style="-fx-padding: 10 20;" text="Bewertungen anzeigen" />
        <Button onAction="#registerWaitlist" style="-fx-padding: 10 20;" text="Auf die Warteliste" />
        <Button fx:id="buttonBackToSearch" onAction="#handleBack" style="-fx-padding: 10 20;" text="Zurück" />
    </HBox>
</VBox>
