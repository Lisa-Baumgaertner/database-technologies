<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<GridPane fx:id="gridPane" alignment="CENTER" hgap="10" vgap="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="application.controller.EmployeeAddController">

    <!-- Abstand für die Elemente im Fenster -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Formular Felder -->
    <Label text="Vorname:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Vorname eingeben"/>

    <Label text="Nachname:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Nachname eingeben"/>

    <Label text="Geburtsdatum:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <DatePicker fx:id="birthDateField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Geschlecht:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <ComboBox fx:id="genderComboBox" GridPane.rowIndex="3" GridPane.columnIndex="1">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="M"/>
                <String fx:value="F"/>
            </FXCollections>
        </items>
    </ComboBox>

    <Label text="Rolle:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <Label text="Mitarbeiter" GridPane.rowIndex="4" GridPane.columnIndex="1" fx:id="roleLabel"/>

    <!-- Adresse -->
    <Label text="Straße:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <TextField fx:id="streetField" GridPane.rowIndex="5" GridPane.columnIndex="1" promptText="Straße eingeben"/>

    <Label text="Hausnummer:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <TextField fx:id="houseNumberField" GridPane.rowIndex="6" GridPane.columnIndex="1" promptText="Hausnummer eingeben"/>

    <Label text="Stadt:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
    <TextField fx:id="cityField" GridPane.rowIndex="7" GridPane.columnIndex="1" promptText="Stadt eingeben"/>

    <Label text="Postleitzahl:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
    <TextField fx:id="zipCodeField" GridPane.rowIndex="8" GridPane.columnIndex="1" promptText="Postleitzahl eingeben"/>

    <!-- Kontakt -->
    <Label text="Telefon:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
    <TextField fx:id="phoneField" GridPane.rowIndex="9" GridPane.columnIndex="1" promptText="Telefonnummer eingeben"/>

    <Label text="Mobil:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
    <TextField fx:id="mobileField" GridPane.rowIndex="10" GridPane.columnIndex="1" promptText="Handynummer eingeben"/>

    <Label text="E-Mail:" GridPane.rowIndex="11" GridPane.columnIndex="0"/>
    <TextField fx:id="emailField" GridPane.rowIndex="11" GridPane.columnIndex="1" promptText="E-Mail-Adresse eingeben"/>

    <!-- Button zum Hinzufügen -->
    <Button text="Mitarbeiter hinzufügen" GridPane.rowIndex="12" GridPane.columnIndex="1" onAction="#handleAddMitarbeiter"/>
</GridPane>
