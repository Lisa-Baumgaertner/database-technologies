<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controller.UserDetailsController"
      spacing="10" alignment="center" style="-fx-padding: 20; -fx-background-color: #f4f4f4;">

    <!-- Titel -->
    <Label text="Nutzerdetails" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Nutzerdetails -->
    <GridPane hgap="10" vgap="10" alignment="center">
        <Label text="Benutzer-ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="userIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Vorname:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="firstNameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Nachname:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="lastNameLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="E-Mail:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="emailLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Adresse:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="addressLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Geburtsdatum:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Label fx:id="birthDateLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Geschlecht:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <Label fx:id="genderLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Rolle:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <Label fx:id="roleLabel" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Buttons -->
    <HBox spacing="10" alignment="center">
        <Button text="Zurück" onAction="#showDefaultView" style="-fx-padding: 10 20;"/>
    </HBox>
</VBox>
